# ==============================================================================
# AURA-Rx FastAPI Backend Environment Configuration
# Capstone Project: Explainable Multimodal AI for Handwritten Prescription Understanding
# ==============================================================================

# Core API Configuration
PROJECT_NAME="AURA-Rx Backend - Explainable Multimodal AI for Handwritten Prescription Understanding"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
DEBUG=false

# Server Network Settings
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8000"]

# File Storage Configuration (Original Prescription Image Preservation)
UPLOAD_DIR="backend/uploads"
MAX_UPLOAD_SIZE_BYTES=15728640  # 15 MB
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp","image/tiff","image/bmp","image/svg+xml"]

# Pipeline Execution Mode (True for Phase 2 Mock Pipeline, False for Future Live Pipeline)
USE_MOCK_PIPELINE=true

# Multimodal Vision-Language Model Configuration (Phase 6)
# Provider choices: "gemini" (production/cloud) or "mock" (offline test fixture mode)
MULTIMODAL_PROVIDER=gemini
MULTIMODAL_MODEL_ID=gemini-3.8-flash
# Optional: Set your Google Gemini API key here for live multimodal inference
# When unset or offline, the system safely falls back to deterministic mock or returns MODEL_UNAVAILABLE
GEMINI_API_KEY=

