# ==============================================================================
# DawaAI FastAPI Backend Environment Configuration (backend/.env.example)
# Capstone Project: Explainable Multimodal AI for Handwritten Prescription Understanding
# ==============================================================================

# Core API Configuration
PROJECT_NAME="DawaAI Backend - Explainable Multimodal AI for Handwritten Prescription Understanding"
VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=false

# Server Network Settings
HOST=127.0.0.1
PORT=8001

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["https://dawaai-prescription-decoder.vercel.app","http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8001"]

# File Storage Configuration (Original Prescription Image Preservation)
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE_BYTES=15728640  # 15 MB
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp","image/tiff","image/bmp","image/svg+xml"]

# Pipeline Execution Mode (false for Live Multimodal Pipeline, true for Mock Pipeline)
USE_MOCK_PIPELINE=false

# Multimodal Vision-Language Model Configuration
# Provider choices: "gemini" (production/cloud) or "mock" (offline test fixture mode)
MULTIMODAL_PROVIDER=gemini
MULTIMODAL_MODEL_ID=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
MULTIMODAL_MAX_TOKENS=4096
MULTIMODAL_TIMEOUT_SECONDS=50.0

# Google Gemini API key for live multimodal inference (Required when USE_MOCK_PIPELINE=false)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional fallback:
# GOOGLE_API_KEY=

# OCR Engine Configuration (Optional: path to Tesseract binary if not in system PATH)
# Windows example: TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
TESSERACT_CMD=

# Ephemeral PHI Retention (0 for zero-retention / immediate purge after request)
RETENTION_TTL_SECONDS=0

# API Security, Authentication & Rate Limiting
API_KEY=
REQUIRE_API_KEY=false
RATE_LIMIT_PER_MINUTE=60

