# ==============================================================================
# DawaAI - Production Environment Configuration Template (.env.production.example)
# Explainable Multimodal AI for Handwritten Prescription Understanding
# ==============================================================================
# Copy this file or inject these variables in your deployment environment (e.g. Render / Vercel).
# IMPORTANT: Never commit actual API keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT CONFIGURATION (Vite / Vercel)
# ------------------------------------------------------------------------------
# Public API base URL used by frontend HTTP client to connect to Render backend:
VITE_API_BASE_URL=https://dawaai-api-swayam.onrender.com
VITE_USE_MOCK_API=false
VITE_API_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# 2. BACKEND API ENVIRONMENT CONFIGURATION (FastAPI on Render / Container)
# ------------------------------------------------------------------------------
# Core API Metadata
PROJECT_NAME="DawaAI Backend - Explainable Multimodal AI for Handwritten Prescription Understanding"
VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=false

# Server Network Configuration (Render sets $PORT dynamically; app binds to 0.0.0.0)
HOST=0.0.0.0
PORT=8000

# Allowed CORS Origins (comma-separated list or JSON array of authorized origins in production)
CORS_ORIGINS=https://dawaai-prescription-decoder.vercel.app,http://localhost:5173,http://localhost:3000

# Pipeline Execution Mode (Must be 'false' in production for live multimodal inference)
USE_MOCK_PIPELINE=false

# Multimodal AI Provider Credentials
# Required when USE_MOCK_PIPELINE=false. Supply via Render Environment Secrets.
GEMINI_API_KEY=
# Optional fallback:
# GOOGLE_API_KEY=

# Multimodal Gemini Model Configuration
MULTIMODAL_MODEL_ID=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
MULTIMODAL_MAX_TOKENS=4096
MULTIMODAL_TIMEOUT_SECONDS=50.0
MULTIMODAL_PROVIDER=gemini

# OCR Engine Configuration (Optional: path to Tesseract binary if not auto-detected on PATH)
# In production Docker, Tesseract is pre-installed at /usr/bin/tesseract
TESSERACT_CMD=

# File Storage Configuration (Preserving original uploaded prescription images)
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE_BYTES=15728640
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp","image/tiff","image/bmp","image/svg+xml"]

# Ephemeral PHI Retention (0 for zero-retention / immediate purge after request)
RETENTION_TTL_SECONDS=0

# API Security, Authentication & Rate Limiting
API_KEY=
REQUIRE_API_KEY=false
RATE_LIMIT_PER_MINUTE=60

