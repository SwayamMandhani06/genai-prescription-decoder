# ==============================================================================
# AURA-Rx Production Environment Configuration Template (.env.production.example)
# Explainable Multimodal AI for Handwritten Prescription Understanding
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# API Prefix
API_V1_PREFIX=/api/v1

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_API=false

# Pipeline Execution Mode
# Set to 'false' in production to run multimodal extraction, RAG, and LASA services.
USE_MOCK_PIPELINE=false

# Multimodal AI Provider Credentials
# Required when USE_MOCK_PIPELINE=false. Provide your Google Gemini API key.
# In deployment environments, supply via container environment variables or secrets manager.
GEMINI_API_KEY=

# File Storage Configuration
# Local storage path for preserving original uploaded prescription images immutably.
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE_BYTES=15728640

# Allowed MIME Types for Prescription Images
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp","image/tiff","image/bmp"]

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list or JSON array of authorized origins in production
CORS_ORIGINS=["https://aura-rx.health.local","http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
