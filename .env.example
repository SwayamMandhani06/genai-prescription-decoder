# ==============================================================================
# DawaAI - Full-Stack Production & Local Environment Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: Never commit actual API keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT CONFIGURATION (Vite / Vercel)
# ------------------------------------------------------------------------------
# Public API base URL used by frontend HTTP client.
# Local Development: http://127.0.0.1:8001
# Production on Vercel: Set to your public backend URL (e.g., https://dawaai-api-swayam.onrender.com)
VITE_API_BASE_URL=http://127.0.0.1:8001

# Standalone Demonstration Mode:
# - 'false': Connects to live FastAPI backend for full multimodal inference.
# - 'true':  Uses rich deterministic in-memory client mocks (useful for UI testing & offline demos).
VITE_USE_MOCK_API=false

# Optional Frontend Client Request Timeout in milliseconds (default: 60000)
VITE_API_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# 2. BACKEND API ENVIRONMENT CONFIGURATION (FastAPI)
# ------------------------------------------------------------------------------
# Core API Metadata
PROJECT_NAME="DawaAI Backend - Explainable Multimodal AI for Handwritten Prescription Understanding"
VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=false

# Network interface and binding port (default preferred port: 8001)
HOST=127.0.0.1
PORT=8001

# Allowed CORS Origins (comma-separated list or JSON array of origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8001,http://127.0.0.1:8001,https://dawaai-prescription-decoder.vercel.app

# Deployment Environment Mode:
# Options: 'development' | 'test' | 'production'
# When set to 'production', mock pipeline execution is strictly forbidden and attempting
# to enable mock mode raises a configuration validation error.
ENV=development
ENVIRONMENT=development

# Pipeline Execution & Inference Mode:
# INFERENCE_MODE: 'live' | 'mock'
# - 'live': Strictly runs genuine vision-language inference via Gemini API. Fails closed (502/503/504)
#   if API key is missing or fails; never silently falls back to fixture data.
# - 'mock': Runs deterministic test fixtures (only permitted in non-production environments).
INFERENCE_MODE=live

# USE_MOCK_PIPELINE: legacy boolean alias (synchronized with INFERENCE_MODE)
# - 'false': Live multimodal inference (forces INFERENCE_MODE=live).
# - 'true':  Deterministic mock fixtures (forces INFERENCE_MODE=mock). Forbidden when ENV=production.
USE_MOCK_PIPELINE=false

# Model Inference Credentials (Required when USE_MOCK_PIPELINE=false)
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional fallback if GEMINI_API_KEY is not set:
# GOOGLE_API_KEY=your_google_api_key_here

# Multimodal Gemini Model Configuration
# Active model: gemini-3.5-flash-lite (also supports gemini-3.1-flash-lite, gemini-3.8-flash)
MULTIMODAL_MODEL_ID=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
MULTIMODAL_MAX_TOKENS=4096
MULTIMODAL_TIMEOUT_SECONDS=50.0
MULTIMODAL_PROVIDER=gemini

# OCR Engine Configuration (Optional: path to Tesseract binary if not on PATH)
# Windows example: TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
# Linux/Container default: auto-detected from /usr/bin/tesseract
TESSERACT_CMD=

# Ephemeral File Storage (Original Prescription Image Preservation)
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE_BYTES=15728640
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp","image/tiff","image/bmp","image/svg+xml"]

# Ephemeral PHI Retention (0 for zero-retention / immediate purge after request)
RETENTION_TTL_SECONDS=0

# API Security, Authentication & Rate Limiting
API_KEY=
REQUIRE_API_KEY=false
RATE_LIMIT_PER_MINUTE=60

